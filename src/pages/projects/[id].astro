---
import Base from '../../layouts/Base.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){const projects=await getCollection('projects',({data})=>!data.draft);return projects.map(project=>({params:{id:project.id},props:{project}}));}
const {project}=Astro.props; const {Content}=await render(project); const p=project.data; const base=(import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/');
---
<Base title={`${p.title} — Zhenkai Zhong`} description={p.summary}><article class="detail"><a class="back" href={`${base}#work`}>← ALL PROJECTS</a><div class="detail-heading"><p class="kicker">{String(p.order).padStart(2,'0')} / {p.category}</p><h1>{p.title}<span>.</span></h1><p class="detail-lead">{p.lead}</p><div class="meta"><div><small>ROLE</small>{p.role}</div><div><small>FOCUS</small>{p.focus}</div><div><small>PERIOD</small>{p.period}</div></div></div><figure class="detail-figure"><div class="detail-cover">{p.cover?<img src={`${base}${p.cover}`} alt={p.coverAlt}/>:<div class="project-placeholder"><span>PLAY / BUILD / ITERATE</span><strong>BATTLE<br/>CAP.</strong></div>}</div>{p.imageNote && <figcaption>{p.imageNote}</figcaption>}</figure><div class="article-grid"><aside>PROJECT NOTES<br/><span>{p.category}</span></aside><div class="prose"><Content/>{p.credits && <section><h2>Credits</h2><p>{p.credits}</p></section>}<div class="article-links">{p.links.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div></div></div><div class="more"><span>KEEP EXPLORING</span><a href={`${base}#work`}>All selected work ↗</a></div></article></Base>


